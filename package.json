{
  "name": "gh-action-release-namer",
  "version": "1.0.0",
  "description": "This action randomly creates a rugged name and adds it to GitHub Actions environment vars.",
  "repository": "https://github.com/tadger/gh-action-release-namer",
  "keywords": ["generator", "random", "rugged"],
  "author": "Jared <tadger>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tadger/gh-action-release-namer/issues"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=24",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --loader:.txt=text --outfile=dist/index.js",
    "format": "biome check --log-level=error --log-kind=pretty --diagnostic-level=error --write .",
    "test": "esbuild src/namer.test.ts --bundle --platform=node --format=cjs --outfile=.test/namer.test.cjs --log-level=error && node --test .test/namer.test.cjs",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && biome ci --log-level=error --log-kind=pretty --diagnostic-level=error ."
  },
  "dependencies": {
    "@actions/core": "3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "5.7.3"
  }
}
